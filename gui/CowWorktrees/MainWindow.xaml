<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CowWorktrees.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CowWorktrees.ViewModels"
    xmlns:controls="using:CowWorktrees.Controls"
    Title="CoW Worktrees">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearch_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="NewWorktree_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="D" Invoked="ToggleDetails_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="Tab_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="Tab_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="Tab_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar (content extends into it) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" />
                <TextBlock Text="CoW Worktrees" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind VM.PoolCaption, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Tabs and commands -->
        <Grid Grid.Row="1" Padding="12,0,8,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" VerticalAlignment="Center">
                <SelectorBarItem x:Name="TabWorktrees" Text="Worktrees" IsSelected="True" ToolTipService.ToolTip="Ctrl+1" />
                <SelectorBarItem x:Name="TabBase" Text="Base" ToolTipService.ToolTip="Ctrl+2" />
                <SelectorBarItem x:Name="TabActivity" Text="Activity" ToolTipService.ToolTip="Ctrl+3" />
            </SelectorBar>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind VM.PoolPickerVisibility, Mode=OneWay}">
                <ComboBox x:Name="PoolBox" ItemsSource="{x:Bind VM.Pools}" SelectedItem="{x:Bind VM.SelectedPool, Mode=OneWay}" SelectionChanged="PoolBox_SelectionChanged"
                          MinWidth="150" AutomationProperties.Name="Repository" ToolTipService.ToolTip="Which repository to show" />
            </StackPanel>
            <CommandBar Grid.Column="2" DefaultLabelPosition="Right" Background="Transparent" OverflowButtonVisibility="Collapsed" VerticalAlignment="Center">
                <AppBarButton Icon="Refresh" Label="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Look at every worktree again now (F5)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="Add" Label="New worktree" Click="New_Click" IsEnabled="{x:Bind VM.HasUsablePool, Mode=OneWay}" ToolTipService.ToolTip="New copy-on-write worktree (Ctrl+N)" />
                <AppBarButton Icon="Cut" Label="Prune…" Click="Prune_Click" IsEnabled="{x:Bind VM.HasUsablePool, Mode=OneWay}" ToolTipService.ToolTip="See which idle worktrees have nothing to lose, then remove them" />
                <AppBarButton Icon="Sync" Label="Refresh base…" Click="RefreshBase_Click" IsEnabled="{x:Bind VM.HasUsablePool, Mode=OneWay}" ToolTipService.ToolTip="Bring the base copy up to date with the project's main branch" />
                <AppBarSeparator />
                <AppBarButton Icon="Setting" Label="Repository" Click="RepositorySettings_Click" IsEnabled="{x:Bind VM.HasUsablePool, Mode=OneWay}" AutomationProperties.AutomationId="Main.RepositorySettings"
                              ToolTipService.ToolTip="Repository settings: connections, options, removal" />
                <AppBarButton Icon="More" Label="More" LabelPosition="Collapsed" AutomationProperties.Name="More" AutomationProperties.AutomationId="Main.More" ToolTipService.ToolTip="Add a repository, app settings">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Add repository…" Click="AddRepository_Click" AutomationProperties.AutomationId="Main.AddRepository">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="IntervalMenu" Text="Refresh the list">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutSubItem.Icon>
                                <RadioMenuFlyoutItem Text="Every 30 s" Tag="30" GroupName="Interval" Click="Interval_Click" />
                                <RadioMenuFlyoutItem Text="Every 45 s" Tag="45" GroupName="Interval" Click="Interval_Click" />
                                <RadioMenuFlyoutItem Text="Every 60 s" Tag="60" GroupName="Interval" Click="Interval_Click" />
                                <RadioMenuFlyoutItem Text="Every 2 min" Tag="120" GroupName="Interval" Click="Interval_Click" />
                                <RadioMenuFlyoutItem Text="Every 5 min" Tag="300" GroupName="Interval" Click="Interval_Click" />
                                <RadioMenuFlyoutItem Text="Only when I press Refresh" Tag="0" GroupName="Interval" Click="Interval_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Check this PC…" Click="CheckPc_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="App settings and About…" Click="AppSettings_Click" AutomationProperties.AutomationId="Main.AppSettings">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <StackPanel Grid.Row="2">
            <!-- A newer version is out -->
            <InfoBar x:Name="UpdateInfoBar" Margin="12,0,12,10" IsOpen="False" IsClosable="True" Severity="Informational" Closed="UpdateInfoBar_Closed">
                <InfoBar.ActionButton>
                    <Button x:Name="UpdateNowButton" Content="Update" Style="{StaticResource AccentButtonStyle}" Click="UpdateNow_Click" AutomationProperties.AutomationId="Main.UpdateNow" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button Content="What's new" Click="UpdateNotes_Click" />
                        <Button x:Name="UpdateSkipButton" Content="Skip this version" Click="UpdateSkip_Click" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
            <!-- Something a repository is connected to has gone missing or points elsewhere -->
            <InfoBar x:Name="DriftInfoBar" Margin="12,0,12,10" IsOpen="True" IsClosable="False" Severity="Warning" Title="This repository's connections need attention"
                     Message="{x:Bind VM.DriftText, Mode=OneWay}" Visibility="{x:Bind VM.DriftVisibility, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Fix it" Click="FixDrift_Click" AutomationProperties.AutomationId="Main.FixDrift" ToolTipService.ToolTip="Run setup again for this repository with its current settings" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- Result of the last create / remove / prune / refresh -->
            <InfoBar x:Name="OpInfoBar" Margin="12,0,12,10" IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="OpInfoAction" Content="Show output" Click="OpInfoAction_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- ============================== Worktrees ============================== -->
        <Grid x:Name="WorktreesPage" Grid.Row="3" Padding="12,0,12,0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" Width="230" QueryIcon="Find" PlaceholderText="Filter (Ctrl+F)" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Filter by name, branch or path; Esc clears" />
                <ComboBox x:Name="FilterBox" Grid.Column="1" SelectionChanged="FilterBox_SelectionChanged" MinWidth="170" VerticalAlignment="Center">
                    <ComboBoxItem Content="All worktrees" />
                    <ComboBoxItem Content="Needs attention" />
                    <ComboBoxItem Content="Dirty" />
                    <ComboBoxItem Content="Unpushed commits" />
                    <ComboBoxItem Content="Prunable" />
                    <ComboBoxItem Content="Copy-on-write only" />
                    <ComboBoxItem Content="Other checkouts" />
                </ComboBox>
                <ComboBox x:Name="SortBox" Grid.Column="2" SelectionChanged="SortBox_SelectionChanged" MinWidth="180" VerticalAlignment="Center" ToolTipService.ToolTip="Or click a column header; click it again to reverse">
                    <ComboBoxItem Content="Sort: needs attention" />
                    <ComboBoxItem Content="Sort: name" />
                    <ComboBoxItem Content="Sort: branch" />
                    <ComboBoxItem Content="Sort: last commit" />
                    <ComboBoxItem Content="Sort: changes" />
                    <ComboBoxItem Content="Sort: unpushed" />
                    <ComboBoxItem Content="Sort: last activity" />
                </ComboBox>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <HyperlinkButton Style="{StaticResource ChipButton}" Click="FilterChip_Click" Tag="All" ToolTipService.ToolTip="Show all worktrees">
                        <Border Style="{StaticResource ChipBorder}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind VM.TotalText, Mode=OneWay}" Style="{StaticResource ChipText}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </HyperlinkButton>
                    <HyperlinkButton Style="{StaticResource ChipButton}" Click="FilterChip_Click" Tag="Dirty" Visibility="{x:Bind VM.DirtyVisibility, Mode=OneWay}" ToolTipService.ToolTip="Show only worktrees with changed or untracked files">
                        <Border Style="{StaticResource ChipBorder}" Background="{ThemeResource SystemFillColorCautionBrush}">
                            <TextBlock Text="{x:Bind VM.DirtyText, Mode=OneWay}" Style="{StaticResource ChipText}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </HyperlinkButton>
                    <HyperlinkButton Style="{StaticResource ChipButton}" Click="FilterChip_Click" Tag="Unpushed" Visibility="{x:Bind VM.UnpushedVisibility, Mode=OneWay}" ToolTipService.ToolTip="Show only worktrees with commits on no remote">
                        <Border Style="{StaticResource ChipBorder}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                            <TextBlock Text="{x:Bind VM.UnpushedText, Mode=OneWay}" Style="{StaticResource ChipText}" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                        </Border>
                    </HyperlinkButton>
                    <HyperlinkButton Style="{StaticResource ChipButton}" Click="FilterChip_Click" Tag="Prunable" Visibility="{x:Bind VM.PrunableVisibility, Mode=OneWay}" ToolTipService.ToolTip="Show only worktrees -Prune would remove">
                        <Border Style="{StaticResource ChipBorder}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind VM.PrunableText, Mode=OneWay}" Style="{StaticResource ChipText}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </HyperlinkButton>
                    <HyperlinkButton Style="{StaticResource ChipButton}" Click="FilterChip_Click" Tag="Attention" Visibility="{x:Bind VM.BrokenVisibility, Mode=OneWay}" ToolTipService.ToolTip="Show worktrees that need attention">
                        <Border Style="{StaticResource ChipBorder}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                            <TextBlock Text="{x:Bind VM.BrokenText, Mode=OneWay}" Style="{StaticResource ChipText}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </Border>
                    </HyperlinkButton>
                    <HyperlinkButton Click="HealthChip_Click" Padding="8,2,8,3" ToolTipService.ToolTip="Base health (Ctrl+2)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{x:Bind VM.HealthBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind VM.HealthSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
                <ToggleButton x:Name="DetailsToggle" Grid.Column="4" Click="DetailsToggle_Click" VerticalAlignment="Center" AutomationProperties.Name="Details pane"
                              ToolTipService.ToolTip="Show or hide the details pane (Ctrl+D)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A0;" FontSize="14" />
                        <TextBlock x:Name="DetailsToggleLabel" Text="Details" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <Grid x:Name="WorktreesBody" Grid.Row="1" ColumnSpacing="12" SizeChanged="WorktreesBody_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DetailsColumn" Width="400" />
                </Grid.ColumnDefinitions>

                <!-- List -->
                <Grid x:Name="ListCard" Style="{StaticResource CardGrid}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="HeaderGrid" Padding="12,0,16,0" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          Background="Transparent" SizeChanged="HeaderGrid_SizeChanged" RightTapped="HeaderGrid_RightTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Current.Col0, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Current.Col1, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Current.Col2, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Current.Col3, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Current.Col4, Mode=OneWay}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}" Click="Header_Click" Tag="Name" AutomationProperties.Name="Sort by worktree">
                            <Grid HorizontalAlignment="Left" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Worktree" Style="{StaticResource ColumnHeaderText}" TextTrimming="CharacterEllipsis" /><FontIcon Grid.Column="1" Glyph="{x:Bind VM.SortGlyphName, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButton}" Click="Header_Click" Tag="Branch" AutomationProperties.Name="Sort by branch">
                            <Grid HorizontalAlignment="Left" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Branch · upstream" Style="{StaticResource ColumnHeaderText}" TextTrimming="CharacterEllipsis" /><FontIcon Grid.Column="1" Glyph="{x:Bind VM.SortGlyphBranch, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButton}" Click="Header_Click" Tag="Commit" AutomationProperties.Name="Sort by last commit">
                            <Grid HorizontalAlignment="Left" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="HEAD" Style="{StaticResource ColumnHeaderText}" TextTrimming="CharacterEllipsis" /><FontIcon Grid.Column="1" Glyph="{x:Bind VM.SortGlyphCommit, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButton}" Click="Header_Click" Tag="Changes" AutomationProperties.Name="Sort by changes">
                            <Grid HorizontalAlignment="Left" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Working tree" Style="{StaticResource ColumnHeaderText}" TextTrimming="CharacterEllipsis" /><FontIcon Grid.Column="1" Glyph="{x:Bind VM.SortGlyphChanges, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                        </Button>
                        <Button Grid.Column="5" Style="{StaticResource ColumnHeaderButton}" Click="Header_Click" Tag="Unpushed" AutomationProperties.Name="Sort by unpushed"
                                ToolTipService.ToolTip="Commits of HEAD that are on no remote (git rev-list HEAD --not --remotes)">
                            <Grid HorizontalAlignment="Left" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Unpushed" Style="{StaticResource ColumnHeaderText}" TextTrimming="CharacterEllipsis" /><FontIcon Grid.Column="1" Glyph="{x:Bind VM.SortGlyphUnpushed, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                        </Button>
                        <Button Grid.Column="6" Style="{StaticResource ColumnHeaderButton}" Click="Header_Click" Tag="Activity" AutomationProperties.Name="Sort by last activity">
                            <Grid HorizontalAlignment="Left" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Last activity" Style="{StaticResource ColumnHeaderText}" TextTrimming="CharacterEllipsis" /><FontIcon Grid.Column="1" Glyph="{x:Bind VM.SortGlyphActivity, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                        </Button>
                        <!-- Edges between columns, sitting in the 12-pixel gaps; after the buttons so they win the hit test. -->
                        <controls:Sizer x:Name="ColumnSizer0" Grid.Column="1" Index="0" HorizontalAlignment="Right" Margin="0,0,-12,0" LineMargin="0,10,0,10" />
                        <controls:Sizer x:Name="ColumnSizer1" Grid.Column="2" Index="1" HorizontalAlignment="Right" Margin="0,0,-12,0" LineMargin="0,10,0,10" />
                        <controls:Sizer x:Name="ColumnSizer2" Grid.Column="3" Index="2" HorizontalAlignment="Right" Margin="0,0,-12,0" LineMargin="0,10,0,10" />
                        <controls:Sizer x:Name="ColumnSizer3" Grid.Column="4" Index="3" HorizontalAlignment="Right" Margin="0,0,-12,0" LineMargin="0,10,0,10" />
                        <controls:Sizer x:Name="ColumnSizer4" Grid.Column="5" Index="4" HorizontalAlignment="Right" Margin="0,0,-12,0" LineMargin="0,10,0,10" />
                    </Grid>
                    <ListView x:Name="WorktreeList" Grid.Row="1" ItemsSource="{x:Bind VM.Visible}" SelectionMode="Single"
                              SelectionChanged="WorktreeList_SelectionChanged" RightTapped="WorktreeList_RightTapped" DoubleTapped="WorktreeList_DoubleTapped" KeyDown="WorktreeList_KeyDown"
                              LayoutUpdated="WorktreeList_LayoutUpdated"
                              ItemContainerStyle="{StaticResource RowContainer}" Padding="0,4,0,4">
                        <ListView.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="CopyPathAccel_Invoked" />
                        </ListView.KeyboardAccelerators>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorktreeViewModel">
                                <Grid MinHeight="56" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Current.Col0, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Current.Col1, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Current.Col2, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Current.Col3, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind vm:ColumnLayout.Current.Col4, Mode=OneWay}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="7" Margin="-6,3,-10,3" CornerRadius="4" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind DirtyVisibility, Mode=OneWay}" />
                                    <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,9" Background="{x:Bind StatusBrush, Mode=OneWay}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <!-- Left-aligned grid: the name takes only the room it needs and is the one trimmed
                                             when the column is narrow, so the tags after it stay visible. -->
                                        <Grid HorizontalAlignment="Left" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Border CornerRadius="8" Padding="6,0,6,1" BorderThickness="1" BorderBrush="{x:Bind KindBrush, Mode=OneWay}" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind KindLabel, Mode=OneWay}" FontSize="11" Foreground="{x:Bind KindBrush, Mode=OneWay}" />
                                                </Border>
                                                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind LockedVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind DetailLock, Mode=OneWay}" />
                                                <Border CornerRadius="8" Padding="6,0,6,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind WouldPruneVisibility, Mode=OneWay}" VerticalAlignment="Center" ToolTipService.ToolTip="-Prune would remove this worktree">
                                                    <TextBlock Text="prunable" FontSize="11" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Path}" Style="{StaticResource SecondaryCaption}" ToolTipService.ToolTip="{x:Bind Path}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind BranchDisplay, Mode=OneWay}" Foreground="{x:Bind BranchBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind BranchDisplay, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource SecondaryCaption}" ToolTipService.ToolTip="{x:Bind DetailUpstream, Mode=OneWay}">
                                            <Run Text="{x:Bind AheadBehindText, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorAttentionBrush}" FontWeight="SemiBold" /><Run Text="{x:Bind UpstreamName, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind CommitLine, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind CommitLine, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind CommitAge, Mode=OneWay}" Style="{StaticResource SecondaryCaption}" />
                                    </StackPanel>

                                    <!-- Changed above untracked, like the two-line cells beside it, so both fit a narrow column. -->
                                    <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border Style="{StaticResource ChipBorder}" Padding="7,0,7,1" HorizontalAlignment="Left" Background="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind ChangedVisibility, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ChangedText, Mode=OneWay}" Style="{StaticResource ChipText}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border Style="{StaticResource ChipBorder}" Padding="7,0,7,1" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind UntrackedVisibility, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind UntrackedText, Mode=OneWay}" Style="{StaticResource ChipText}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind CleanVisibility, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock Text="clean" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ErrorText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200"
                                                   Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ErrorText, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind UnpushedText, Mode=OneWay}" Foreground="{x:Bind UnpushedBrush, Mode=OneWay}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind UnpushedCaption, Mode=OneWay}" Style="{StaticResource SecondaryCaption}" Visibility="{x:Bind UnpushedCaptionVisibility, Mode=OneWay}" />
                                    </StackPanel>

                                    <Grid Grid.Column="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind LastActivityText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind DetailActivity, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <ProgressRing Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Edge between the list and the details pane -->
                <controls:Sizer x:Name="DetailsSizer" Grid.Column="0" Index="-1" HorizontalAlignment="Right" Margin="0,0,-12,0" LineMargin="0,40,0,40" />

                <!-- Details -->
                <Grid x:Name="DetailsCard" Grid.Column="1" Style="{StaticResource CardGrid}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="280" Visibility="{x:Bind VM.NoSelectionVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Select a worktree to see its changes, its unpushed commits and what you can do with it."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Double-click opens it in Explorer · right-click for more · Del removes a copy-on-write worktree · Ctrl+C copies its path · drag header edges to resize columns" />
                    </StackPanel>
                    <ScrollViewer Visibility="{x:Bind VM.DetailsVisibility, Mode=OneWay}">
                        <StackPanel Padding="18,16,18,18" Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind VM.SelectedWorktree.Name, Mode=OneWay, FallbackValue=''}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind VM.SelectedWorktree.Path, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <Border CornerRadius="8" Padding="6,0,6,1" BorderThickness="1" BorderBrush="{x:Bind VM.SelectedWorktree.KindBrush, Mode=OneWay, FallbackValue={x:Null}}">
                                        <TextBlock Text="{x:Bind VM.SelectedWorktree.KindLabel, Mode=OneWay, FallbackValue=''}" FontSize="11" Foreground="{x:Bind VM.SelectedWorktree.KindBrush, Mode=OneWay, FallbackValue={x:Null}}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind VM.SelectedWorktree.DetailLock, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Click="OpenExplorer_Click" AutomationProperties.Name="Explorer" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Open in Explorer (Enter or double-click)">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEC50;" FontSize="14" /><TextBlock Text="Explorer" /></StackPanel>
                                </Button>
                                <Button Grid.Column="1" Click="OpenTerminal_Click" AutomationProperties.Name="Terminal" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE756;" FontSize="14" /><TextBlock Text="Terminal" /></StackPanel>
                                </Button>
                                <Button Grid.Row="1" Click="OpenEditor_Click" AutomationProperties.Name="Open in editor" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsEnabled="{x:Bind VM.EditorAvailable, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE943;" FontSize="14" /><TextBlock Text="{x:Bind VM.OpenInEditorLabel, Mode=OneWay}" /></StackPanel>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" Click="CopyPath_Click" AutomationProperties.Name="Copy path" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Copy the path (Ctrl+C in the list)">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="14" /><TextBlock Text="Copy path" /></StackPanel>
                                </Button>
                            </Grid>

                            <Button Click="Migrate_Click" AutomationProperties.Name="Move to copy-on-write" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,-8,0,0"
                                    Visibility="{x:Bind VM.SelectedWorktree.MigrateVisibility, Mode=OneWay, FallbackValue=Collapsed}"
                                    ToolTipService.ToolTip="This is a full copy of the project. Move it into a copy-on-write clone to get its disk space back; everything in it is carried over and checked.">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8DE;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Move to copy-on-write…" />
                                </StackPanel>
                            </Button>

                            <Button Click="Remove_Click" AutomationProperties.Name="Remove worktree" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,-8,0,0"
                                    Visibility="{x:Bind VM.SelectedWorktree.RemoveVisibility, Mode=OneWay, FallbackValue=Collapsed}"
                                    ToolTipService.ToolTip="Remove this worktree (Del). A worktree with changed or untracked files is refused, so nothing is lost by accident.">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="Remove worktree…" />
                                </StackPanel>
                            </Button>

                            <StackPanel Spacing="10">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="Branch" Style="{StaticResource DetailKey}" />
                                    <TextBlock Text="{x:Bind VM.SelectedWorktree.BranchDisplay, Mode=OneWay, FallbackValue=''}" Style="{StaticResource DetailValue}" />
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="Upstream" Style="{StaticResource DetailKey}" />
                                    <TextBlock Text="{x:Bind VM.SelectedWorktree.DetailUpstream, Mode=OneWay, FallbackValue=''}" Style="{StaticResource DetailValue}" />
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="HEAD" Style="{StaticResource DetailKey}" />
                                    <TextBlock Text="{x:Bind VM.SelectedWorktree.Subject, Mode=OneWay, FallbackValue=''}" Style="{StaticResource DetailValue}" />
                                    <TextBlock Text="{x:Bind VM.SelectedWorktree.DetailHead, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextBlockStyle}" FontFamily="{StaticResource MonoFont}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind VM.SelectedWorktree.DetailCommitWhen, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="Working tree" Style="{StaticResource DetailKey}" />
                                    <TextBlock Text="{x:Bind VM.SelectedWorktree.DetailChanges, Mode=OneWay, FallbackValue=''}" Style="{StaticResource DetailValue}" />
                                    <TextBlock Text="{x:Bind VM.SelectedWorktree.DetailStatusTime, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="Commits on no remote" Style="{StaticResource DetailKey}" />
                                    <TextBlock Text="{x:Bind VM.SelectedWorktree.DetailUnpushed, Mode=OneWay, FallbackValue=''}" Style="{StaticResource DetailValue}" />
                                    <ItemsControl ItemsSource="{x:Bind VM.SelectedWorktree.UnpushedLog, Mode=OneWay, FallbackValue={x:Null}}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="Last activity" Style="{StaticResource DetailKey}" />
                                    <TextBlock Text="{x:Bind VM.SelectedWorktree.DetailActivity, Mode=OneWay, FallbackValue=''}" Style="{StaticResource DetailValue}" />
                                </StackPanel>
                                <StackPanel Spacing="1" Visibility="{x:Bind VM.SelectedWorktree.CowDetailVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                    <TextBlock Text="Copy-on-write" Style="{StaticResource DetailKey}" />
                                    <TextBlock Text="{x:Bind VM.SelectedWorktree.DetailCow, Mode=OneWay, FallbackValue=''}" Style="{StaticResource DetailValue}" />
                                    <TextBlock Text="{x:Bind VM.SelectedWorktree.PruneText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="4" Visibility="{x:Bind VM.SelectedWorktree.StatusLinesVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                <TextBlock Text="{x:Bind VM.SelectedWorktree.StatusLinesHeader, Mode=OneWay, FallbackValue=''}" Style="{StaticResource DetailKey}" />
                                <ItemsControl ItemsSource="{x:Bind VM.SelectedWorktree.StatusLines, Mode=OneWay, FallbackValue={x:Null}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================== Base ============================== -->
        <Grid x:Name="BasePage" Grid.Row="3" Padding="12,0,12,0" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Style="{StaticResource CardGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="18,14,14,6">
                    <StackPanel>
                        <TextBlock Text="Base health" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind VM.HealthUpdated, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="RefreshBase_Click" AutomationProperties.Name="Refresh base (health panel)">
                        <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Sync" /><TextBlock Text="Refresh base…" /></StackPanel>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{x:Bind VM.HealthItems}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HealthItemViewModel">
                                <Grid Padding="18,10,18,10" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Value}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Column="1" Style="{StaticResource CardGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="10,6,14,0">
                    <SelectorBar x:Name="LogTabs" SelectionChanged="LogTabs_SelectionChanged">
                        <SelectorBarItem x:Name="LogHook" Text="hook.log" IsSelected="True" />
                        <SelectorBarItem x:Name="LogRefresh" Text="refresh.log" />
                        <SelectorBarItem x:Name="LogBuild" Text="base-build.log" />
                    </SelectorBar>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenCowRoot_Click" AutomationProperties.Name="Open folder" ToolTipService.ToolTip="Open the copy-on-write root in Explorer">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEC50;" FontSize="14" /><TextBlock Text="Open folder" /></StackPanel>
                    </Button>
                </Grid>
                <ScrollViewer x:Name="LogScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap" IsTextSelectionEnabled="True" Padding="18,10,18,18" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================== Activity ============================== -->
        <Grid x:Name="ActivityPage" Grid.Row="3" Padding="12,0,12,0" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Style="{StaticResource CardGrid}">
                <TextBlock x:Name="NoOpsText" Text="Create, remove, prune and base refreshes run here with their full output." TextWrapping="Wrap" Margin="24"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                <ListView x:Name="OpsList" ItemsSource="{x:Bind VM.Operations}" SelectionChanged="OpsList_SelectionChanged" ItemContainerStyle="{StaticResource CompactRowContainer}" Padding="0,6,0,6">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:OperationViewModel">
                            <Grid Padding="2,8,2,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Top" Margin="0,2,0,0">
                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" FontSize="16" Visibility="{x:Bind DoneVisibility, Mode=OneWay}" />
                                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsRunning, Mode=OneWay}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource SecondaryCaption}" />
                                    <TextBlock Text="{x:Bind StartedText}" Style="{StaticResource SecondaryCaption}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid Grid.Column="1" Style="{StaticResource CardGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="18,14,14,10" ColumnSpacing="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{x:Bind VM.SelectedOperation.Title, Mode=OneWay, FallbackValue='No operation selected'}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind VM.SelectedOperation.Summary, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind VM.SelectedOperation.StatusBrush, Mode=OneWay, FallbackValue={x:Null}}" />
                        <TextBlock Text="{x:Bind VM.SelectedOperation.CommandLine, Mode=OneWay, FallbackValue=''}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Click="StopOperation_Click" AutomationProperties.Name="Stop" AutomationProperties.AutomationId="Activity.Stop"
                                Visibility="{x:Bind VM.SelectedOperation.CancelVisibility, Mode=OneWay, FallbackValue=Collapsed}"
                                ToolTipService.ToolTip="Stop this run. What it was making is removed again, or can be picked up later.">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;" FontSize="14" /><TextBlock Text="Stop" /></StackPanel>
                        </Button>
                        <CheckBox x:Name="AutoScrollBox" Content="Follow output" IsChecked="True" MinWidth="0" />
                        <Button Click="CopyOutput_Click" AutomationProperties.Name="Copy output" ToolTipService.ToolTip="Copy the whole output">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="14" /><TextBlock Text="Copy" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <ListView x:Name="OpLines" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" Padding="0,6,0,6"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="14,0,14,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:OutputLine">
                            <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Brush}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap" IsTextSelectionEnabled="True" Padding="0,1,0,1" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- ============================== No usable pool ============================== -->
        <Grid x:Name="EmptyState" Grid.Row="3" Padding="12,0,12,0" Visibility="Collapsed">
            <Grid Style="{StaticResource CardGrid}">
                <StackPanel MaxWidth="640" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Padding="24">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="56" Height="56" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind VM.EmptyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind VM.EmptyText, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button x:Name="EmptyPrimaryButton" Content="{x:Bind VM.EmptyPrimaryLabel, Mode=OneWay}" Click="EmptyPrimary_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="130"
                                AutomationProperties.AutomationId="Main.GetStarted" />
                        <Button Content="Open folder" Click="OpenEmptyStateFolder_Click" ToolTipService.ToolTip="Open the repository's folder, or the folder this app keeps its files in" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="4" Padding="18,6,18,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing Width="12" Height="12" IsActive="{x:Bind VM.IsRefreshing, Mode=OneWay}" />
                <TextBlock Text="{x:Bind VM.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind VM.Problem, Mode=OneWay}" Visibility="{x:Bind VM.ProblemVisibility, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind VM.Problem, Mode=OneWay}" />
            <HyperlinkButton Grid.Column="2" Click="RunningOps_Click" Visibility="{x:Bind VM.RunningVisibility, Mode=OneWay}" Padding="6,0,6,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing Width="12" Height="12" IsActive="True" />
                    <TextBlock Text="{x:Bind VM.RunningText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </HyperlinkButton>
        </Grid>

        <!-- ============================== Walkthrough and settings, over everything below the title bar ============================== -->
        <Grid x:Name="OverlayHost" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" />
    </Grid>
</Window>
