<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CowWorktrees.Views.SetupWizard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CowWorktrees.ViewModels"
    xmlns:svc="using:CowWorktrees.Services"
    KeyDown="Root_KeyDown">

    <UserControl.Resources>
        <Style x:Key="WizardTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="WizardLead" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="WizardNote" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="WizardCard" TargetType="Grid" BasedOn="{StaticResource CardGrid}">
            <Setter Property="Padding" Value="18,14,18,14" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Step rail ============================== -->
        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="24,28,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="32" Height="32" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CoW Worktrees" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Getting started" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <ItemsControl Grid.Row="1" ItemsSource="{x:Bind VM.Rail}" Margin="0,28,0,0" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RailItem">
                        <Grid ColumnSpacing="12" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="26" Height="26">
                                <Ellipse Fill="{x:Bind CircleBrush, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Number}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind NumberBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{x:Bind NumberVisibility, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Visibility="{x:Bind DoneVisibility, Mode=OneWay}" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{x:Bind Label}" Foreground="{x:Bind LabelBrush, Mode=OneWay}" FontWeight="{x:Bind LabelWeight, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="2" Style="{StaticResource WizardNote}" Text="Nothing on this PC changes until you press Set up." />
        </Grid>

        <!-- ============================== Screens ============================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <Grid Padding="48,36,48,24" MaxWidth="860" HorizontalAlignment="Left">

                    <!-- 1. Welcome -->
                    <StackPanel Spacing="14" Visibility="{x:Bind VM.WelcomeVisibility, Mode=OneWay}">
                        <TextBlock Text="Worktrees in seconds, without the disk space" Style="{StaticResource WizardTitle}" />
                        <TextBlock Style="{StaticResource WizardLead}"
                                   Text="A worktree is a second working copy of your project, so you (or an AI agent) can work on several things at once. Normally each one is a full copy that takes minutes to make and gigabytes to store. On a Dev Drive, this app makes them in seconds, and they take almost no space until files change." />
                        <TextBlock Text="What happens next" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,14,0,0" />
                        <Grid Style="{StaticResource WizardCard}" ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon Glyph="&#xE9D9;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Check this PC" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource WizardNote}" Text="Windows, Git and a Dev Drive. If something is missing, you get a button that helps you fix it." />
                            </StackPanel>
                            <FontIcon Grid.Row="1" Glyph="&#xE8B7;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                <TextBlock Text="Choose your project" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource WizardNote}" Text="One of your Git projects, and a folder on the Dev Drive where its worktrees will live." />
                            </StackPanel>
                            <FontIcon Grid.Row="2" Glyph="&#xE99A;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                                <TextBlock Text="Connect your AI tools" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource WizardNote}" Text="Claude Code and Codex then make their worktrees this way by themselves. You choose which, and you can see exactly what is added." />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource WizardNote}" Margin="0,6,0,0"
                                   Text="It takes a few minutes; most of that is one full copy of your project, made once. Prefer the command line? setup.ps1 in the cow-worktrees folder does the same, and the last screen shows the exact command." />
                    </StackPanel>

                    <!-- 2. Check this PC -->
                    <StackPanel Spacing="14" Visibility="{x:Bind VM.ChecksVisibility, Mode=OneWay}">
                        <TextBlock Text="Check this PC" Style="{StaticResource WizardTitle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing Width="18" Height="18" IsActive="{x:Bind VM.IsChecking, Mode=OneWay}" Visibility="{x:Bind VM.IsChecking, Mode=OneWay}" />
                            <TextBlock x:Name="ChecksHeadline" Text="{x:Bind VM.ChecksHeadline, Mode=OneWay}" Style="{StaticResource WizardLead}" Margin="0" AutomationProperties.AutomationId="Wizard.ChecksHeadline" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind VM.Checks}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CheckRowViewModel">
                                    <Grid Style="{StaticResource WizardCard}" Margin="0,0,0,10" ColumnSpacing="16" AutomationProperties.Name="{x:Bind AutomationName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" FontSize="22" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{x:Bind Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource WizardNote}" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind Steps}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22" Visibility="{x:Bind StepsVisibility}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top">
                                            <Button Content="{x:Bind FixLabel}" Tag="{x:Bind FixId}" Click="Fix_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Visibility="{x:Bind FixVisibility}" />
                                            <Button Content="{x:Bind SecondLabel}" Tag="{x:Bind SecondId}" Click="Fix_Click" HorizontalAlignment="Stretch" Visibility="{x:Bind SecondVisibility}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind VM.AgentsFoundText, Mode=OneWay}" Style="{StaticResource WizardNote}" />
                        <HyperlinkButton Content="Check again" Click="CheckAgain_Click" Padding="0" AutomationProperties.AutomationId="Wizard.CheckAgain" />
                    </StackPanel>

                    <!-- 3. Choose your project -->
                    <StackPanel Spacing="14" Visibility="{x:Bind VM.ProjectVisibility, Mode=OneWay}">
                        <TextBlock Text="Choose your project" Style="{StaticResource WizardTitle}" />
                        <TextBlock Style="{StaticResource WizardLead}" Text="The folder of a project that is under Git: the one you open in your editor." />
                        <Grid ColumnSpacing="8" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RepoBox" Header="Project folder" PlaceholderText="D:\src\MyProject" Text="{x:Bind VM.RepoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="Wizard.RepoPath" IsSpellCheckEnabled="False" />
                            <Button Grid.Column="1" Content="Browse…" Click="BrowseRepo_Click" VerticalAlignment="Bottom" AutomationProperties.AutomationId="Wizard.Browse" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind VM.RepoChecking, Mode=OneWay}">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind VM.RepoChecking, Mode=OneWay}" />
                            <TextBlock Text="Looking at the folder…" Style="{StaticResource WizardNote}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid ColumnSpacing="10" Visibility="{x:Bind VM.RepoStatusVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind VM.RepoStatusGlyph, Mode=OneWay}" Foreground="{x:Bind VM.RepoStatusBrush, Mode=OneWay}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Text="{x:Bind VM.RepoStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="Wizard.RepoStatus" />
                        </Grid>
                        <Button Content="{x:Bind VM.RepoSuggestionLabel, Mode=OneWay}" Click="UseSuggestedRepo_Click" Visibility="{x:Bind VM.RepoSuggestionVisibility, Mode=OneWay}" AutomationProperties.AutomationId="Wizard.UseMain" />
                        <StackPanel Spacing="6" Margin="0,14,0,0" Visibility="{x:Bind VM.BaseRefVisibility, Mode=OneWay}">
                            <AutoSuggestBox x:Name="BaseRefBox" Header="New worktrees start from" Width="360" HorizontalAlignment="Left" Text="{x:Bind VM.BaseRef, Mode=TwoWay}"
                                            TextChanged="BaseRefBox_TextChanged" GotFocus="BaseRefBox_GotFocus" AutomationProperties.AutomationId="Wizard.BaseRef" />
                            <TextBlock Style="{StaticResource WizardNote}" Text="Usually your main branch on the server, such as origin/main. The base copy follows this branch, and a new worktree starts there unless you say otherwise." />
                        </StackPanel>
                    </StackPanel>

                    <!-- 4. Where worktrees live -->
                    <StackPanel Spacing="14" Visibility="{x:Bind VM.LocationVisibility, Mode=OneWay}">
                        <TextBlock Text="Where worktrees live" Style="{StaticResource WizardTitle}" />
                        <TextBlock Style="{StaticResource WizardLead}" Text="On a Dev Drive, a copy of a file takes no extra space until the copy is changed. That is what makes worktrees quick and cheap, so they have to live there." />
                        <ComboBox x:Name="DriveBox" Header="Dev Drive" ItemsSource="{x:Bind VM.Drives}" SelectedItem="{x:Bind VM.SelectedDrive, Mode=OneWay}" SelectionChanged="DriveBox_SelectionChanged"
                                  MinWidth="420" Margin="0,8,0,0" AutomationProperties.AutomationId="Wizard.Drive" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RootBox" Header="Folder for this project's worktrees" Text="{x:Bind VM.RootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanging="RootBox_TextChanging"
                                     AutomationProperties.AutomationId="Wizard.RootPath" IsSpellCheckEnabled="False" />
                            <Button Grid.Column="1" Content="Browse…" Click="BrowseRoot_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid ColumnSpacing="10" Visibility="{x:Bind VM.RootStatusVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind VM.RootStatusGlyph, Mode=OneWay}" Foreground="{x:Bind VM.RootStatusBrush, Mode=OneWay}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Text="{x:Bind VM.RootStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="Wizard.RootStatus" />
                        </Grid>
                        <TextBlock Text="{x:Bind VM.BaseFolderText, Mode=OneWay}" Style="{StaticResource WizardNote}" />
                    </StackPanel>

                    <!-- 5. Connect your AI tools -->
                    <StackPanel Spacing="12" Visibility="{x:Bind VM.ToolsVisibility, Mode=OneWay}">
                        <TextBlock Text="Connect your AI tools" Style="{StaticResource WizardTitle}" />
                        <TextBlock Style="{StaticResource WizardLead}" Text="Once connected, these tools make their worktrees as copy-on-write clones by themselves. Each switch can be changed later in Repository settings." />

                        <Grid Style="{StaticResource WizardCard}" Margin="0,8,0,0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Claude Code" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind VM.ClaudeFoundText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource WizardNote}" Text="claude --worktree, subagents and desktop sessions get a clone in seconds." />
                                <Expander Header="What exactly gets added" Margin="0,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <TextBlock Text="{x:Bind VM.ClaudeDetail, Mode=OneWay}" Style="{StaticResource WizardNote}" IsTextSelectionEnabled="True" />
                                </Expander>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind VM.ClaudeOn, Mode=TwoWay}" VerticalAlignment="Top" MinWidth="0" AutomationProperties.Name="Connect Claude Code" AutomationProperties.AutomationId="Wizard.Claude" />
                        </Grid>

                        <Grid Style="{StaticResource WizardCard}" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Codex" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind VM.CodexFoundText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource WizardNote}" Text="Codex is told to make worktrees of this project as clones." />
                                <Expander Header="What exactly gets added" Margin="0,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <TextBlock Text="{x:Bind VM.CodexDetail, Mode=OneWay}" Style="{StaticResource WizardNote}" IsTextSelectionEnabled="True" />
                                </Expander>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind VM.CodexOn, Mode=TwoWay}" VerticalAlignment="Top" MinWidth="0" AutomationProperties.Name="Connect Codex" AutomationProperties.AutomationId="Wizard.Codex" />
                        </Grid>

                        <Grid Style="{StaticResource WizardCard}" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Daily upkeep" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource WizardNote}" Text="Once a day, when the PC is idle: tidy away worktrees nobody uses any more, and bring the base copy up to date." />
                                <TimePicker x:Name="SchedulePicker" Header="Start at" ClockIdentifier="24HourClock" MinuteIncrement="15" Margin="0,8,0,0" SelectedTimeChanged="SchedulePicker_SelectedTimeChanged"
                                            IsEnabled="{x:Bind VM.ScheduleOn, Mode=OneWay}" AutomationProperties.AutomationId="Wizard.ScheduleTime" />
                                <Expander Header="What exactly gets added" Margin="0,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <TextBlock Text="{x:Bind VM.ScheduleDetail, Mode=OneWay}" Style="{StaticResource WizardNote}" IsTextSelectionEnabled="True" />
                                </Expander>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind VM.ScheduleOn, Mode=TwoWay}" VerticalAlignment="Top" MinWidth="0" AutomationProperties.Name="Daily upkeep" AutomationProperties.AutomationId="Wizard.Schedule" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock Text="Using another agent?" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton x:Name="CopyInstructionsLink" Content="Copy the instructions" Click="CopyInstructions_Click" Padding="4,2,4,2" ToolTipService.ToolTip="Text to paste into any agent's instruction file" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 6. Faster first builds -->
                    <StackPanel Spacing="14" Visibility="{x:Bind VM.BuildsVisibility, Mode=OneWay}">
                        <TextBlock Text="Faster first builds" Style="{StaticResource WizardTitle}" />
                        <TextBlock Style="{StaticResource WizardLead}"
                                   Text="Optional, and only for projects that build with MSBuild (Visual Studio). The base copy is built once a day, and every new worktree starts with that build output, so its first build has almost nothing to compile." />
                        <ToggleSwitch Header="Build the base copy" IsOn="{x:Bind VM.BuildOn, Mode=TwoWay}" OnContent="On" OffContent="Off (you can turn it on later)" Margin="0,8,0,0" AutomationProperties.AutomationId="Wizard.BuildOn" />
                        <Grid ColumnSpacing="10" Visibility="{x:Bind VM.SolutionTextVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Text="{x:Bind VM.SolutionText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <StackPanel Spacing="10" Visibility="{x:Bind VM.BuildFieldsVisibility, Mode=OneWay}">
                            <TextBox Header="Build command" Text="{x:Bind VM.BuildCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" IsSpellCheckEnabled="False"
                                     PlaceholderText="msbuild MyProject.sln /m /p:Configuration={config} /p:Platform=x64" AutomationProperties.AutomationId="Wizard.BuildCommand" />
                            <TextBox Header="Configurations" Text="{x:Bind VM.BuildConfigs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left" IsSpellCheckEnabled="False"
                                     PlaceholderText="Debug,Release" AutomationProperties.AutomationId="Wizard.BuildConfigs" />
                            <TextBlock Style="{StaticResource WizardNote}" Text="{}{config} in the command is replaced by each configuration in turn. The command runs in the base copy with Windows PowerShell; the first build happens with the next daily upkeep, or when you press Refresh base." />
                        </StackPanel>
                    </StackPanel>

                    <!-- 7. Review, then set up -->
                    <StackPanel Spacing="14" Visibility="{x:Bind VM.ReviewVisibility, Mode=OneWay}">
                        <TextBlock Text="Review, then set up" Style="{StaticResource WizardTitle}" Visibility="{x:Bind VM.ReviewSummaryVisibility, Mode=OneWay}" />
                        <StackPanel Spacing="14" Visibility="{x:Bind VM.ReviewSummaryVisibility, Mode=OneWay}">
                            <Grid Style="{StaticResource WizardCard}">
                                <ItemsControl ItemsSource="{x:Bind VM.ReviewLines}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,3,0,3" IsTextSelectionEnabled="True" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <TextBlock Style="{StaticResource WizardNote}" Text="The first step makes one full copy of your project on the Dev Drive. For a large project that takes several minutes; after that, every worktree takes seconds. You can keep using the PC meanwhile." />
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Error" Title="Setup cannot run from here" Message="{x:Bind VM.SetupBlockedReason, Mode=OneWay}" Visibility="{x:Bind VM.NextBlockedVisibility, Mode=OneWay}" />
                            <Expander Header="Show details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource WizardNote}" Text="This is the PowerShell command the app runs when you press Set up. Running it yourself does exactly the same." />
                                    <TextBlock Text="{x:Bind VM.CommandLine, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="Wizard.CommandLine" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <!-- while it runs, and afterwards when it failed -->
                        <StackPanel Spacing="14" Visibility="{x:Bind VM.RunningVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind VM.RunningHeadline, Mode=OneWay}" Style="{StaticResource WizardTitle}" AutomationProperties.AutomationId="Wizard.RunningHeadline" />
                                <TextBlock Text="{x:Bind VM.RunningElapsed, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            </StackPanel>
                            <Grid Style="{StaticResource WizardCard}">
                                <ItemsControl ItemsSource="{x:Bind VM.Operation.Steps, Mode=OneWay}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StepItem">
                                            <Grid ColumnSpacing="12" Margin="0,5,0,5" Opacity="{x:Bind Opacity, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Foreground="{x:Bind Brush, Mode=OneWay}" FontSize="16" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                                <ProgressRing Width="16" Height="16" IsActive="True" Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Label}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind VM.StopVisibility, Mode=OneWay}">
                                <Button Content="Stop" Click="Stop_Click" AutomationProperties.AutomationId="Wizard.Stop" />
                                <TextBlock Style="{StaticResource WizardNote}" VerticalAlignment="Center" Text="Stopping now removes the partly made copy again; nothing else has changed yet." />
                            </StackPanel>

                            <Grid Style="{StaticResource WizardCard}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind VM.FailedVisibility, Mode=OneWay}" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA39;" FontSize="22" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="{x:Bind VM.ErrorTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="Wizard.ErrorTitle" />
                                    <TextBlock Text="{x:Bind VM.ErrorText, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind VM.ErrorRaw, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind VM.ErrorRawVisibility, Mode=OneWay}" />
                                    <Button Content="{x:Bind VM.ErrorActionLabel, Mode=OneWay}" Click="ErrorAction_Click" Visibility="{x:Bind VM.ErrorActionVisibility, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <Expander Header="Show details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ListView ItemsSource="{x:Bind VM.Operation.Lines, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="280"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Auto">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Padding" Value="4,0,4,0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OutputLine">
                                            <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Brush}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap" Padding="0,1,0,1" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Expander>
                        </StackPanel>
                    </StackPanel>

                    <!-- 8. All set -->
                    <StackPanel Spacing="14" Visibility="{x:Bind VM.DoneVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE930;" FontSize="34" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="You're all set" Style="{StaticResource WizardTitle}" VerticalAlignment="Center" AutomationProperties.AutomationId="Wizard.AllSet" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind VM.DoneText, Mode=OneWay}" Style="{StaticResource WizardLead}" />

                        <Grid Style="{StaticResource WizardCard}" Margin="0,8,0,0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Try it" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource WizardNote}" Text="Make a worktree now and see how long it takes. You can remove it again with one click." />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Create your first worktree" Style="{StaticResource AccentButtonStyle}" Click="FirstWorktree_Click" VerticalAlignment="Center" AutomationProperties.AutomationId="Wizard.FirstWorktree" />
                        </Grid>

                        <Grid Style="{StaticResource WizardCard}" Visibility="{x:Bind VM.ClaudeDoneVisibility, Mode=OneWay}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Claude Code" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource WizardNote}" Text="Restart any Claude Code session that is open: it reads the new settings when a session starts. Then, in your project:" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="10,5,10,6">
                                        <TextBlock Text="{x:Bind VM.ClaudeCommand}" FontFamily="{StaticResource MonoFont}" IsTextSelectionEnabled="True" />
                                    </Border>
                                    <Button Click="CopyClaudeCommand_Click" AutomationProperties.Name="Copy the command" ToolTipService.ToolTip="Copy">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource WizardCard}" Visibility="{x:Bind VM.CodexDoneVisibility, Mode=OneWay}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Codex" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource WizardNote}" Text="{x:Bind VM.CodexTip}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ============================== Back / Next ============================== -->
            <Grid Grid.Row="1" Padding="48,14,32,18" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Content="{x:Bind VM.CancelLabel, Mode=OneWay}" Click="Cancel_Click" Visibility="{x:Bind VM.CancelVisibility, Mode=OneWay}" AutomationProperties.AutomationId="Wizard.Cancel" />
                <TextBlock Grid.Column="1" Text="{x:Bind VM.NextBlockedReason, Mode=OneWay}" Visibility="{x:Bind VM.NextBlockedVisibility, Mode=OneWay}" Style="{StaticResource WizardNote}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="Wizard.Blocked" />
                <Button x:Name="BackButton" Grid.Column="2" Content="Back" Click="Back_Click" MinWidth="90" Visibility="{x:Bind VM.BackVisibility, Mode=OneWay}" AutomationProperties.AutomationId="Wizard.Back" />
                <Button x:Name="NextButton" Grid.Column="3" Content="{x:Bind VM.NextLabel, Mode=OneWay}" Click="Next_Click" MinWidth="120" Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind VM.CanGoNext, Mode=OneWay}" Visibility="{x:Bind VM.NextVisibility, Mode=OneWay}" AutomationProperties.AutomationId="Wizard.Next" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
