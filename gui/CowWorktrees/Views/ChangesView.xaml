<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CowWorktrees.Views.ChangesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CowWorktrees.ViewModels"
    xmlns:local="using:CowWorktrees.Views"
    KeyDown="Root_KeyDown">

    <UserControl.Resources>
        <!-- A button that is only its icon until the pointer is over it -->
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,6,7,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="GutterText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource DiffGutterTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,2,10,2" />
        </Style>
        <Style x:Key="CodeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{ThemeResource DiffCodeTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="Margin" Value="0,1,14,1" />
        </Style>
        <Style x:Key="MarkerText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,0,1" />
        </Style>
        <Style x:Key="DiffRowContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style x:Key="FileRowContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,0,12,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- ============ the rows of the diff ============ -->
        <DataTemplate x:Key="FileHeaderTemplate" x:DataType="vm:FileHeaderRow">
            <Grid Margin="16,14,16,0" Padding="6,7,8,7" ColumnSpacing="10" CornerRadius="8,8,0,0" BorderThickness="1"
                  Background="{ThemeResource DiffFileHeaderBrush}" BorderBrush="{ThemeResource DiffFileBorderBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource QuietButton}" Click="Collapse_Click" Tag="{x:Bind File}" ToolTipService.ToolTip="{x:Bind File.CollapseTip, Mode=OneWay}" AutomationProperties.Name="Show or hide this file's lines">
                    <FontIcon Glyph="{x:Bind File.Chevron, Mode=OneWay}" FontSize="12" />
                </Button>
                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="6" Background="{x:Bind File.KindFill}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind File.KindText}">
                    <TextBlock Text="{x:Bind File.Badge}" Foreground="{x:Bind File.KindBrush}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True">
                        <Run Text="{x:Bind File.Folder}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{x:Bind File.Name}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="{x:Bind File.Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind File.KindBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind File.AddedText}" Foreground="{ThemeResource DiffAddedTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="SemiBold" Visibility="{x:Bind File.AddedVisibility}" />
                    <TextBlock Text="{x:Bind File.DeletedText}" Foreground="{ThemeResource DiffRemovedTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="SemiBold" Visibility="{x:Bind File.DeletedVisibility}" />
                </StackPanel>
                <Border Grid.Column="4" CornerRadius="3" VerticalAlignment="Center" Height="8">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="{x:Bind File.GreenWidth}" Background="{ThemeResource DiffAddedBarBrush}" />
                        <Border Width="{x:Bind File.RedWidth}" Background="{ThemeResource DiffRemovedBarBrush}" />
                        <Border Width="{x:Bind File.EmptyWidth}" Background="{ThemeResource DiffBarEmptyBrush}" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="0">
                    <Button Style="{StaticResource QuietButton}" Click="OpenFile_Click" Tag="{x:Bind File}" ToolTipService.ToolTip="Open this file" AutomationProperties.Name="Open this file">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource QuietButton}" Click="RevealFile_Click" Tag="{x:Bind File}" ToolTipService.ToolTip="Show it in Explorer" AutomationProperties.Name="Show this file in Explorer">
                        <FontIcon Glyph="&#xEC50;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource QuietButton}" ToolTipService.ToolTip="Copy" AutomationProperties.Name="Copy">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Copy the path" Click="CopyPath_Click" Tag="{x:Bind File}" />
                                <MenuFlyoutItem Text="Copy the full path" Click="CopyFullPath_Click" Tag="{x:Bind File}" />
                                <MenuFlyoutItem Text="Copy these changes as a patch" Click="CopyPatch_Click" Tag="{x:Bind File}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FileEndTemplate" x:DataType="vm:FileEndRow">
            <Border Margin="16,0,16,0" Height="8" CornerRadius="0,0,8,8" BorderThickness="1,0,1,1"
                    Background="{ThemeResource DiffSurfaceBrush}" BorderBrush="{ThemeResource DiffFileBorderBrush}" />
        </DataTemplate>

        <DataTemplate x:Key="HunkTemplate" x:DataType="vm:HunkRow">
            <Border Margin="16,0,16,0" BorderThickness="1,0,1,0" Background="{ThemeResource DiffSurfaceBrush}" BorderBrush="{ThemeResource DiffFileBorderBrush}">
                <Border Background="{ThemeResource DiffHunkBrush}" Padding="14,4,14,4">
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind Range}" Foreground="{ThemeResource DiffHunkTextBrush}" /><Run Text="   " /><Run Text="{x:Bind Context}" Foreground="{ThemeResource DiffGutterTextBrush}" />
                    </TextBlock>
                </Border>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ContextLineTemplate" x:DataType="vm:LineRow">
            <Grid Margin="16,0,16,0" BorderThickness="1,0,1,0" Background="{ThemeResource DiffSurfaceBrush}" BorderBrush="{ThemeResource DiffFileBorderBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind OldNo}" Style="{StaticResource GutterText}" />
                <TextBlock Grid.Column="1" Text="{x:Bind NewNo}" Style="{StaticResource GutterText}" />
                <TextBlock Grid.Column="3" Text="{x:Bind Text}" Style="{StaticResource CodeText}" local:Highlight.Line="{x:Bind}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AddedLineTemplate" x:DataType="vm:LineRow">
            <Grid Margin="16,0,16,0" BorderThickness="1,0,1,0" Background="{ThemeResource DiffSurfaceBrush}" BorderBrush="{ThemeResource DiffFileBorderBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="4" Background="{ThemeResource DiffAddedLineBrush}" />
                <Border Grid.ColumnSpan="2" Background="{ThemeResource DiffAddedGutterBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind NewNo}" Style="{StaticResource GutterText}" Foreground="{ThemeResource DiffAddedTextBrush}" />
                <TextBlock Grid.Column="2" Text="+" Style="{StaticResource MarkerText}" Foreground="{ThemeResource DiffAddedTextBrush}" />
                <TextBlock Grid.Column="3" Text="{x:Bind Text}" Style="{StaticResource CodeText}"
                           local:Highlight.Brush="{ThemeResource DiffAddedWordBrush}" local:Highlight.Line="{x:Bind}" />
                <FontIcon Grid.Column="3" Glyph="&#xE7BA;" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" Foreground="{ThemeResource DiffGutterTextBrush}"
                          Visibility="{x:Bind NoNewlineVisibility}" ToolTipService.ToolTip="The file does not end with a line break here" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RemovedLineTemplate" x:DataType="vm:LineRow">
            <Grid Margin="16,0,16,0" BorderThickness="1,0,1,0" Background="{ThemeResource DiffSurfaceBrush}" BorderBrush="{ThemeResource DiffFileBorderBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="4" Background="{ThemeResource DiffRemovedLineBrush}" />
                <Border Grid.ColumnSpan="2" Background="{ThemeResource DiffRemovedGutterBrush}" />
                <TextBlock Text="{x:Bind OldNo}" Style="{StaticResource GutterText}" Foreground="{ThemeResource DiffRemovedTextBrush}" />
                <TextBlock Grid.Column="2" Text="&#x2212;" Style="{StaticResource MarkerText}" Foreground="{ThemeResource DiffRemovedTextBrush}" />
                <TextBlock Grid.Column="3" Text="{x:Bind Text}" Style="{StaticResource CodeText}"
                           local:Highlight.Brush="{ThemeResource DiffRemovedWordBrush}" local:Highlight.Line="{x:Bind}" />
                <FontIcon Grid.Column="3" Glyph="&#xE7BA;" FontSize="11" HorizontalAlignment="Right" Margin="0,0,6,0" Foreground="{ThemeResource DiffGutterTextBrush}"
                          Visibility="{x:Bind NoNewlineVisibility}" ToolTipService.ToolTip="The file did not end with a line break here" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NoteTemplate" x:DataType="vm:NoteRow">
            <Border Margin="16,0,16,0" BorderThickness="1,0,1,0" Background="{ThemeResource DiffSurfaceBrush}" BorderBrush="{ThemeResource DiffFileBorderBrush}">
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="16,9,16,9">
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" MaxWidth="900" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <HyperlinkButton Content="{x:Bind ActionLabel}" Click="NoteAction_Click" Tag="{x:Bind}" Visibility="{x:Bind ActionVisibility}" Padding="6,2,6,2" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:DiffRowTemplateSelector x:Key="RowSelector"
            FileHeader="{StaticResource FileHeaderTemplate}" FileEnd="{StaticResource FileEndTemplate}" Hunk="{StaticResource HunkTemplate}"
            ContextLine="{StaticResource ContextLineTemplate}" AddedLine="{StaticResource AddedLineTemplate}" RemovedLine="{StaticResource RemovedLineTemplate}"
            Note="{StaticResource NoteTemplate}" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ what is being looked at, and how much changed ============ -->
        <Grid x:Name="HeaderBar" Padding="8,8,16,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource QuietButton}" Click="Back_Click" Padding="10,8,10,8" ToolTipService.ToolTip="Back to the list (Esc)" AutomationProperties.Name="Back" AutomationProperties.AutomationId="Changes.Back">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0" MaxWidth="420">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis">
                    <Run Text="Changes in" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Normal" /><Run Text=" " /><Run Text="{x:Bind VM.Title}" />
                </TextBlock>
                <TextBlock Style="{StaticResource SecondaryCaption}" ToolTipService.ToolTip="{x:Bind VM.Where}">
                    <Run Text="{x:Bind VM.Branch}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" /><Run Text="  &#x00B7;  " /><Run Text="{x:Bind VM.Where}" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" HorizontalAlignment="Left" Margin="8,0,0,0">
                <ComboBox x:Name="ScopeBox" ItemsSource="{x:Bind VM.Scopes}" SelectedItem="{x:Bind VM.Scope, Mode=OneWay}" SelectionChanged="ScopeBox_SelectionChanged"
                          MinWidth="380" MaxWidth="620" AutomationProperties.Name="What to compare" AutomationProperties.AutomationId="Changes.Scope"
                          ToolTipService.ToolTip="Choose what to look at: the uncommitted edits, all work in this worktree, or one commit">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChangeScope">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxWidth="540" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{x:Bind VM.ScopeCaption, Mode=OneWay}" Style="{StaticResource SecondaryCaption}" Margin="2,0,0,0" MaxWidth="620" />
            </StackPanel>

            <!-- the totals: files, lines added, lines removed, and their proportion -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Visibility="{x:Bind VM.TotalsVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind VM.FilesCaption, Mode=OneWay}">
                <TextBlock Text="{x:Bind VM.FilesText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="Changes.Files" />
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind VM.AddedText, Mode=OneWay}" Foreground="{ThemeResource DiffAddedTextBrush}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind VM.DeletedText, Mode=OneWay}" Foreground="{ThemeResource DiffRemovedTextBrush}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Border CornerRadius="3" Height="6" Width="132">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{x:Bind VM.AddedShare, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind VM.DeletedShare, Mode=OneWay}" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource DiffAddedBarBrush}" />
                            <Border Grid.Column="1" Background="{ThemeResource DiffRemovedBarBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Style="{StaticResource QuietButton}" Click="FoldAll_Click" ToolTipService.ToolTip="Hide or show every file's lines" AutomationProperties.Name="Fold or unfold all files">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon x:Name="FoldIcon" Glyph="&#xE73F;" FontSize="14" /><TextBlock x:Name="FoldLabel" Text="Fold all" /></StackPanel>
                </Button>
                <Button Style="{StaticResource QuietButton}" Click="Refresh_Click" ToolTipService.ToolTip="Read the changes again (F5)" AutomationProperties.Name="Refresh">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Refresh" /></StackPanel>
                </Button>
                <Button Style="{StaticResource QuietButton}" Click="FullScreen_Click" ToolTipService.ToolTip="Use the whole screen (F11)" AutomationProperties.Name="Full screen">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="14" /><TextBlock x:Name="FullScreenLabel" Text="Full screen" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- the worktree changed after the list was read -->
        <Border Grid.Row="1" Margin="12,0,12,10" Padding="14,7,10,7" CornerRadius="6" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind VM.StaleVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                <TextBlock Text="This worktree changed after these changes were read." VerticalAlignment="Center" />
                <HyperlinkButton Content="Read them again" Click="Refresh_Click" Padding="6,2,6,2" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Padding="12,0,12,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilesColumn" Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ the files ============ -->
            <Grid Style="{StaticResource CardGrid}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <AutoSuggestBox x:Name="FilterBox" Margin="12,12,12,8" QueryIcon="Find" PlaceholderText="Filter files (Ctrl+F)" TextChanged="FilterBox_TextChanged" AutomationProperties.Name="Filter files" />
                <ListView x:Name="FileList" Grid.Row="1" ItemsSource="{x:Bind VM.Files, Mode=OneWay}" SelectionMode="Single" SelectionChanged="FileList_SelectionChanged"
                          ItemContainerStyle="{StaticResource FileRowContainer}" Padding="0,0,0,6" AutomationProperties.Name="Changed files" AutomationProperties.AutomationId="Changes.FileList">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChangeFileItem">
                            <Grid ColumnSpacing="10" Padding="0,6,0,7" ToolTipService.ToolTip="{x:Bind Tip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="6" Background="{x:Bind KindFill}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Badge}" Foreground="{x:Bind KindBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Folder}" Style="{StaticResource SecondaryCaption}" Visibility="{x:Bind FolderVisibility}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind AddedText}" Foreground="{ThemeResource DiffAddedTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Visibility="{x:Bind AddedVisibility}" />
                                        <TextBlock Text="{x:Bind DeletedText}" Foreground="{ThemeResource DiffRemovedTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Visibility="{x:Bind DeletedVisibility}" />
                                    </StackPanel>
                                    <Border CornerRadius="2" Height="4" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="{x:Bind GreenWidth}" Background="{ThemeResource DiffAddedBarBrush}" />
                                            <Border Width="{x:Bind RedWidth}" Background="{ThemeResource DiffRemovedBarBrush}" />
                                            <Border Width="{x:Bind EmptyWidth}" Background="{ThemeResource DiffBarEmptyBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="14,8,14,9">
                    <StackPanel Spacing="1">
                        <TextBlock Text="{x:Bind VM.FilesCaption, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind VM.Footnote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ every changed line ============ -->
            <Grid Grid.Column="1" Style="{StaticResource CardGrid}">
                <ListView x:Name="DiffList" ItemsSource="{x:Bind VM.Rows, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False"
                          ItemTemplateSelector="{StaticResource RowSelector}" ItemContainerStyle="{StaticResource DiffRowContainer}"
                          Padding="0,0,0,28" Visibility="{x:Bind VM.BodyVisibility, Mode=OneWay}" AutomationProperties.Name="Changed lines" AutomationProperties.AutomationId="Changes.Lines" />

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="460" Visibility="{x:Bind VM.EmptyVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" FontSize="34" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="{x:Bind VM.EmptyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                    <TextBlock Text="{x:Bind VM.EmptyText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <InfoBar Severity="Error" IsOpen="True" IsClosable="False" VerticalAlignment="Top" Margin="16" Title="The changes could not be read"
                         Message="{x:Bind VM.Problem, Mode=OneWay}" Visibility="{x:Bind VM.ProblemVisibility, Mode=OneWay}" />

                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,14,26,0" Padding="12,7,14,7" CornerRadius="16" Visibility="{x:Bind VM.LoadingVisibility, Mode=OneWay}"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing Width="16" Height="16" IsActive="True" />
                        <TextBlock Text="Reading the changes…" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
