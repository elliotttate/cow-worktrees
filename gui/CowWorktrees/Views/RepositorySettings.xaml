<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CowWorktrees.Views.RepositorySettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CowWorktrees.ViewModels"
    KeyDown="Root_KeyDown">

    <UserControl.Resources>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,18,0,2" />
        </Style>
        <Style x:Key="Card" TargetType="Grid" BasedOn="{StaticResource CardGrid}">
            <Setter Property="Padding" Value="18,14,18,14" />
        </Style>
        <!-- One connection: what it is, what is there now, and a switch -->
        <DataTemplate x:Key="IntegrationRow" x:DataType="vm:IntegrationRowViewModel">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Blurb}" Style="{StaticResource Note}" />
                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,4,0,0">
                        <Ellipse Width="8" Height="8" Fill="{x:Bind StateBrush, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource Note}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <Button Grid.Column="1" Content="Repair" Click="Repair_Click" VerticalAlignment="Top" Visibility="{x:Bind RepairVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="Run setup again with the saved settings, so this points at this copy of the tool in every folder of the project" />
                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsOn, Mode=TwoWay}" VerticalAlignment="Top" MinWidth="0" AutomationProperties.Name="{x:Bind Title}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="20,10,28,12" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="Back_Click" AutomationProperties.Name="Back" AutomationProperties.AutomationId="Settings.Back" ToolTipService.ToolTip="Back to the worktrees (Esc)" VerticalAlignment="Center" Padding="8">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind VM.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="Settings.Title" />
                <TextBlock Text="{x:Bind VM.Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="48,10,48,28" MaxWidth="940" HorizontalAlignment="Left" Spacing="8">

                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="{x:Bind VM.Problem, Mode=OneWay}" Visibility="{x:Bind VM.ProblemVisibility, Mode=OneWay}" Margin="0,8,0,0" />

                <!-- Connections -->
                <TextBlock Text="Connections" Style="{StaticResource Section}" />
                <Grid Style="{StaticResource Card}">
                    <ContentControl Content="{x:Bind VM.Claude}" ContentTemplate="{StaticResource IntegrationRow}" HorizontalContentAlignment="Stretch" IsTabStop="False" AutomationProperties.AutomationId="Settings.Claude" />
                </Grid>
                <Grid Style="{StaticResource Card}">
                    <ContentControl Content="{x:Bind VM.Codex}" ContentTemplate="{StaticResource IntegrationRow}" HorizontalContentAlignment="Stretch" IsTabStop="False" AutomationProperties.AutomationId="Settings.Codex" />
                </Grid>
                <Grid Style="{StaticResource Card}" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl Content="{x:Bind VM.Schedule}" ContentTemplate="{StaticResource IntegrationRow}" HorizontalContentAlignment="Stretch" IsTabStop="False" AutomationProperties.AutomationId="Settings.Schedule" />
                    <TimePicker x:Name="SchedulePicker" Grid.Row="1" Header="Start at" ClockIdentifier="24HourClock" MinuteIncrement="15" SelectedTimeChanged="SchedulePicker_SelectedTimeChanged"
                                IsEnabled="{x:Bind VM.Schedule.IsOn, Mode=OneWay}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                    <TextBlock Text="Using another agent?" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Name="CopyInstructionsLink" Content="Copy the instructions" Click="CopyInstructions_Click" Padding="4,2,4,2" ToolTipService.ToolTip="Text to paste into any agent's instruction file" />
                </StackPanel>

                <!-- Options -->
                <TextBlock Text="Options" Style="{StaticResource Section}" />
                <Grid Style="{StaticResource Card}" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="5">
                        <AutoSuggestBox x:Name="BaseRefBox" Header="New worktrees start from" Width="360" HorizontalAlignment="Left" Text="{x:Bind VM.BaseRef, Mode=TwoWay}" TextChanged="BaseRefBox_TextChanged"
                                        GotFocus="BaseRefBox_GotFocus" AutomationProperties.AutomationId="Settings.BaseRef" />
                        <TextBlock Style="{StaticResource Note}" Text="The branch the base copy follows, usually your main branch on the server (origin/main). Changing it takes effect at the next refresh of the base." />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="5">
                        <NumberBox Header="Remove idle worktrees after (days)" Value="{x:Bind VM.PruneDays, Mode=TwoWay}" Minimum="0" Maximum="365" SpinButtonPlacementMode="Inline" Width="220" HorizontalAlignment="Left"
                                   AutomationProperties.AutomationId="Settings.PruneDays" />
                        <TextBlock Style="{StaticResource Note}" Text="{x:Bind VM.PruneNote, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="5">
                        <TextBox Header="Branch prefix for agent worktrees" Text="{x:Bind VM.BranchPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left" IsSpellCheckEnabled="False" />
                        <TextBlock Style="{StaticResource Note}" Text="Worktrees that Claude Code asks for get a branch with this prefix. Such a branch is deleted with its worktree when it never gained a commit." />
                    </StackPanel>
                </Grid>

                <!-- Faster first builds -->
                <TextBlock Text="Faster first builds" Style="{StaticResource Section}" />
                <Grid Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource Note}" Text="For projects that build with MSBuild (Visual Studio): the base copy is built once a day, and every new worktree starts with that build output, so its first build has almost nothing to compile." />
                        <ToggleSwitch Header="Build the base copy" IsOn="{x:Bind VM.BuildOn, Mode=TwoWay}" AutomationProperties.AutomationId="Settings.BuildOn" />
                        <StackPanel Spacing="10" Visibility="{x:Bind VM.BuildFieldsVisibility, Mode=OneWay}">
                            <TextBox Header="Build command" Text="{x:Bind VM.BuildCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" IsSpellCheckEnabled="False"
                                     PlaceholderText="msbuild MyProject.sln /m /p:Configuration={config} /p:Platform=x64" AutomationProperties.AutomationId="Settings.BuildCommand" />
                            <TextBox Header="Configurations" Text="{x:Bind VM.BuildConfigs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left" IsSpellCheckEnabled="False" PlaceholderText="Debug,Release" />
                            <TextBox Header="Before the build (optional)" Text="{x:Bind VM.BuildPrepare, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" IsSpellCheckEnabled="False"
                                     IsEnabled="{x:Bind VM.PrepareEditable, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Note}" Text="{x:Bind VM.PrepareNote, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Expander Header="Show details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,10,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource Note}" Text="Apply runs this PowerShell command. Running it yourself does exactly the same." />
                        <TextBlock Text="{x:Bind VM.CommandLine, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="Settings.CommandLine" />
                    </StackPanel>
                </Expander>

                <!-- Remove -->
                <TextBlock Text="Remove" Style="{StaticResource Section}" />
                <Grid Style="{StaticResource Card}" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Remove this repository from the app" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Note}" Text="Disconnects Claude Code and Codex, removes the daily upkeep and forgets the repository. Your project, its worktrees and its branches stay exactly as they are." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Remove…" Click="Remove_Click" VerticalAlignment="Center" AutomationProperties.AutomationId="Settings.Remove" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Apply -->
        <Grid Grid.Row="2" Padding="48,12,32,16" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind VM.IsBusy, Mode=OneWay}" Visibility="{x:Bind VM.BusyVisibility, Mode=OneWay}" />
                <TextBlock Text="Applying… the steps are on the Activity tab." Style="{StaticResource Note}" VerticalAlignment="Center" Visibility="{x:Bind VM.BusyVisibility, Mode=OneWay}" />
                <FontIcon x:Name="ResultIcon" FontSize="16" Visibility="{x:Bind VM.ResultVisibility, Mode=OneWay}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Visibility="{x:Bind VM.ResultVisibility, Mode=OneWay}" MaxWidth="560">
                    <TextBlock Text="{x:Bind VM.ResultTitle, Mode=OneWay}" FontWeight="SemiBold" AutomationProperties.AutomationId="Settings.Result" />
                    <TextBlock Text="{x:Bind VM.ResultText, Mode=OneWay}" Style="{StaticResource Note}" MaxLines="4" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="Discard changes" Click="Discard_Click" IsEnabled="{x:Bind VM.HasChanges, Mode=OneWay}" />
            <Button Grid.Column="2" Content="Apply" Click="Apply_Click" MinWidth="110" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind VM.CanApply, Mode=OneWay}" AutomationProperties.AutomationId="Settings.Apply" />
        </Grid>
    </Grid>
</UserControl>
